# ── Django Core ─────────────────────────────────────────────────────────────
# Generated secure key — do NOT share this with anyone
DJANGO_SECRET_KEY=LoRhNDoombXcWVO6GeKoWxcfYJJKG7_aDipX7wiLgyycjOAZU-0nLKO8DZHj75d_nG4

# Set to "False" in production (True only for local development)
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts for production
# Example: ALLOWED_HOSTS=nextoDeals.com,www.nextoDeals.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Admin Portal Credentials ────────────────────────────────────────────────
# Custom admin portal login (NOT the Django superuser)
NEXTO_ADMIN_USERNAME=Nibin@2007
NEXTO_ADMIN_PASSWORD=Nibin@@@123@@@123

# ── SMS / OTP Provider ──────────────────────────────────────────────────────
# Set to: console | fast2sms | twilio
SMS_PROVIDER=console

# Fast2SMS (https://fast2sms.com → Dashboard → Dev API → copy key)
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# Twilio (https://twilio.com → Console → Account Info)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_COUNTRY_CODE=+91
